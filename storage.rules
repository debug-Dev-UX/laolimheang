rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Public read for all uploaded assets ──────────────────────────
    match /{allPaths=**} {
      allow read: if true;
    }

    // ── Gallery images: only signed-in admin can upload/delete ────────
    match /gallery/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Project images ────────────────────────────────────────────────
    match /projects/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Blog images ───────────────────────────────────────────────────
    match /blogs/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Generic uploads folder ────────────────────────────────────────
    match /uploads/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
