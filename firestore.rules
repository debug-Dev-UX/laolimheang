rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PUBLIC collections (read by anyone) ──────────────────────────
    // Gallery, Portfolio, Services, Blog posts, About/Skills
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /skills/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /about/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /project_images/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── PRIVATE collections (admin only) ─────────────────────────────
    match /messages/{docId} {
      // Anyone can submit a contact form message
      allow create: if true;
      // Only signed-in admin can read/update/delete
      allow read, update, delete: if request.auth != null;
    }
    match /analytics/{docId} {
      allow read, write: if request.auth != null;
    }
    match /visitors/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Catch-all: deny everything else ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
